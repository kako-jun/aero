{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aero",
  "version": "0.1.0",
  "identifier": "com.kakojun.aero",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "aero",
        "width": 260,
        "height": 90,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
